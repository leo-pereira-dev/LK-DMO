# Root workspace outputs
/build-temp/
/ClientDist/
/clientdist/

# Local build/package outputs outside the nested project ignores
/Release/
/Give/

# Runtime logs and local overrides
*.log
*.binlog
*.tmp
*.bak
*.bak-*
*.local.*

# Visual Studio and editor state
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Heavy generated binaries/debug artifacts
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.ilk
*.tlog
*.lastbuildstate
*.exe
_tmp_*.png

# Local client packs / extracted data used only as analysis input
/union/
/Dcommerce/
/unpacke_full/
/unpacked_full/
/unpack_full/
pack*.hf
pack*.pf
dm_union-*.bin
DM_Union*.bin

# Docker/local database volumes or dumps generated during experiments
docker-data/
postgres-data/
mysql-data/

# Local decompiled exe dumps used only as analysis input
/unpacked_exe_all/
