                                            <TextBlock Text="{Binding AssetSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MapDisplay}" Foreground="{StaticResource Muted}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
