<Window x:Class="ItemEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="LKDMO Assets Editor"
        Width="1320"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#090D12">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#101820" />
        <SolidColorBrush x:Key="Panel2" Color="#151F29" />
        <SolidColorBrush x:Key="Line" Color="#273746" />
        <SolidColorBrush x:Key="Text" Color="#EDF5FF" />
        <SolidColorBrush x:Key="Muted" Color="#9AA8B8" />
        <SolidColorBrush x:Key="Accent" Color="#35D0A3" />
        <SolidColorBrush x:Key="Warn" Color="#F0B35A" />
        <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#182431" />
            <Setter Property="BorderBrush" Value="#33475D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#213349" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#173044" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#123B33" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="Chrome" Property="Background" Value="#101A24" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource Muted}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#0B1117"
                                        BorderBrush="{StaticResource Accent}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5F6D7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InvisibleScrollBarButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#071018" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="RootChrome" Background="Transparent" SnapsToDevicePixels="True">
                            <Border Background="#071018"
                                    BorderBrush="#1B2C3B"
                                    BorderThickness="1"
                                    CornerRadius="6" />
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource InvisibleScrollBarButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" MinHeight="28" MinWidth="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbChrome"
                                                        Background="#27465A"
                                                        BorderBrush="#376B82"
                                                        BorderThickness="1"
                                                        CornerRadius="6" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="#2D6F78" />
                                                        <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#7CF1D2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource InvisibleScrollBarButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="12" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="12" />
                                <Setter Property="Height" Value="Auto" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="#0D151D" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#123B33" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#0D151D" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#132232" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#123B33" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#101820" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F171F" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LKDMO Assets Editor" FontSize="26" FontWeight="Bold" />
                    <TextBlock x:Name="SourceText"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource Muted}"
                               Text="Load the English bin folder to inspect items, effects, buffs, and boxes." />
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="680" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DB"
                                   Foreground="{StaticResource Accent}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="DbConnectionBox"
                                 Grid.Column="1"
                                 HorizontalAlignment="Stretch"
                                 ToolTip="Local app setting. Used to edit Asset_Container and Asset_ContainerReward directly." />
                        <WrapPanel Grid.Column="2" Margin="8,0,0,0">
                            <Button x:Name="TestDbButton" Content="Test DB" Click="TestDb_Click" Padding="10,6" />
                            <Button x:Name="LoadDbBoxesButton" Content="Load DB Boxes" Click="LoadDbBoxes_Click" Margin="8,0,0,0" Padding="10,6" />
                            <Button x:Name="SaveBoxDbButton" Content="Save Box DB" Click="SaveBoxDb_Click" Margin="8,0,0,0" Padding="10,6" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                        </WrapPanel>
                        <TextBlock x:Name="DbStatusText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource Muted}"
                                   Text="Database not tested."
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Load Folder" Click="LoadBins_Click" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                    <Button Content="Load Pack" Margin="8,0,0,0" Click="LoadPack_Click" Background="#15334A" BorderBrush="#4C8FD8" />
                    <Button Content="Save All" Margin="8,0,0,0" Click="Save_Click" Background="#2A3445" />
                    <Button Content="Export JSON" Margin="8,0,0,0" Click="Export_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,16,0,16">
            <TabItem Header="Items">
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Items" FontSize="18" FontWeight="Bold" />
                        <WrapPanel Grid.Column="1">
                            <Button Content="New" Click="NewItem_Click" Padding="10,6" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                            <Button Content="Duplicate" Margin="8,0,0,0" Click="Duplicate_Click" Padding="10,6" />
                        </WrapPanel>
                    </Grid>
                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             Margin="0,10,0,10"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Filter by id, name, type, skill, or effect." />
                    <ListBox x:Name="ItemListBox"
                             Grid.Row="2"
                             SelectionChanged="ItemListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DescriptionPreview}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorPanel" DataContext="{Binding ElementName=ItemListBox, Path=SelectedItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ItemId, StringFormat=Item {0}}" FontSize="14" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding NameTitle}" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="{Binding EffectKind}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" Background="#071018" BorderBrush="#233446" BorderThickness="1" CornerRadius="4">
                                        <Image Source="{Binding IconImage}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Margin="8" />
                                    </Border>
                                    <TextBlock Text="{Binding Icon}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding IconStatus}" Foreground="{StaticResource Muted}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Width="138" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,16,0,0" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="310" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Item Type" Foreground="{StaticResource Muted}" />
                                    <ComboBox x:Name="ItemKindComboBox"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="ItemKindComboBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Selected Type" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="ItemKindDetailText" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TypeDisplay}" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Core Fields" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding SkillCode, StringFormat=SkillCode {0}}" />
                                    <TextBlock Text="{Binding UseMode, StringFormat=UseMode {0}}" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,16,0,16" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <TextBlock Text="{Binding EffectSummary}" TextWrapping="Wrap" Foreground="#C8D4E3" />
                        </Border>

                        <Border Margin="0,0,0,16" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="350" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Item duration" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DurationSummary}" Foreground="#C8D4E3" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="Client/server treat UseTimeType 1, 2, or 3 with minutes above zero as temporary."
                                               Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Timer mode" Foreground="{StaticResource Muted}" />
                                    <TextBox Text="{Binding UseTimeType, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding DurationModeName}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Duration minutes" Foreground="{StaticResource Muted}" />
                                    <TextBox Text="{Binding UsageTimeMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="1 day = 1440, 7 days = 10080, 30 days = 43200" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Quick set" Foreground="{StaticResource Muted}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Permanent" Click="DurationPreset_Click" Tag="0" />
                                        <Button Content="1 day" Click="DurationPreset_Click" Tag="1440" Margin="8,0,0,0" />
                                        <Button Content="7 days" Click="DurationPreset_Click" Tag="10080" Margin="8,0,0,0" />
                                        <Button Content="30 days" Click="DurationPreset_Click" Tag="43200" Margin="8,0,0,0" />
                                    </WrapPanel>
                                    <TextBlock Text="For a temporary outfit, use Timer mode 1 and the desired minutes."
                                               Foreground="#C8D4E3"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Rows="0" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,10,12">
                                <TextBlock Text="Item ID" Foreground="{StaticResource Muted}" />
