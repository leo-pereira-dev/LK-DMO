                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DescriptionPreview}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding EffectKind}" Foreground="{StaticResource Accent}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="Use Selected Item" Click="ApplyRewardItem_Click" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
            </TabItem>

            <TabItem Header="NPCs">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NPCs" FontSize="18" FontWeight="Bold" />
                                <Button Grid.Column="1" Content="New" Click="NewNpc_Click" Padding="10,6" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,10,0,8">
                                <TextBlock Text="Search names / ids" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBox x:Name="NpcSearchBox"
                                         Margin="0,4,0,0"
                                         TextChanged="NpcFilter_Changed"
                                         ToolTip="Filter by NPC id, name, type, model, item, or quest." />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock Text="Map" Foreground="{StaticResource Muted}" FontSize="12" />
                                <ComboBox x:Name="NpcMapFilterComboBox"
                                          Margin="0,4,0,0"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="NpcFilter_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                                <TextBlock Text="NPC type" Foreground="{StaticResource Muted}" FontSize="12" />
                                <ComboBox x:Name="NpcTypeFilterComboBox"
                                          Margin="0,4,0,0"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="NpcFilter_Changed" />
                            </StackPanel>
                            <ListBox x:Name="NpcListBox"
                                     Grid.Row="4"
                                     SelectionChanged="NpcListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AssetSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MapDisplay}" Foreground="{StaticResource Accent}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding ElementName=NpcListBox, Path=SelectedItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NpcId, StringFormat=NPC {0}}" FontSize="14" Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding NameTitle}" FontSize="22" FontWeight="Bold" />
                                        <TextBlock Text="{Binding TypeName}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding AssetSummary}" Foreground="#C8D4E3" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="NPC visual" FontWeight="SemiBold" />
                                            <Border Height="86" Margin="0,8,0,8" Background="#071018" BorderBrush="#233446" BorderThickness="1" CornerRadius="6">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ModelId, StringFormat=Model {0}}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModelComment}" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="200" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding VisualSummary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,16,0,0" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="NPC Type" Foreground="{StaticResource Muted}" />
                                            <ComboBox ItemsSource="{Binding NpcTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValue="{Binding TypeId, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Usage" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding TypeName}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Quest is stored as NPC extra data; shop/portal content is stored in NpcAssets.bin." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Map / model" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding MapDisplay}" />
                                            <TextBlock Text="{Binding ModelId, StringFormat=Model {0}}" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Margin="0,16,0,0" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="300" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="NPC map position" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="MapNpc.bin" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border Background="#071018" BorderBrush="#203546" BorderThickness="1" CornerRadius="6" Padding="6">
                                                <Canvas x:Name="NpcMapCanvas"
                                                        Height="520"
                                                        Background="#071018"
                                                        ClipToBounds="True"
                                                        MouseLeftButtonDown="NpcMapCanvas_MouseLeftButtonDown"
                                                        SizeChanged="NpcMapCanvas_SizeChanged" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding MapDisplay}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PositionSummary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                            <UniformGrid Columns="2" Rows="0">
                                                <StackPanel Margin="0,0,8,10">
                                                    <TextBlock Text="X" Foreground="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding MapPositionX, UpdateSourceTrigger=PropertyChanged}" LostFocus="NpcPositionField_LostFocus" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="Y" Foreground="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding MapPositionY, UpdateSourceTrigger=PropertyChanged}" LostFocus="NpcPositionField_LostFocus" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Rotation" Foreground="{StaticResource Muted}" />
                                                <TextBox Text="{Binding MapRotation, UpdateSourceTrigger=PropertyChanged}" LostFocus="NpcPositionField_LostFocus" />
                                            </StackPanel>
                                            <Button Content="Save NPC Positions" Click="SaveNpcPositions_Click" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                                            <TextBlock Text="Click the minimap to move the selected NPC. This saves only MapNpc.bin positions, not NPC shop/craft data." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Quests unlocked by completing this quest" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Unlocks.Count, StringFormat={}{0} linked}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding Unlocks}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Height="120"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#0D151D"
                                          AlternatingRowBackground="#101A24">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quest ID" Binding="{Binding QuestId}" Width="110" />
                                        <DataGridTextColumn Header="Quest" Binding="{Binding Title}" Width="*" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding QuestTypeName}" Width="180" />
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <UniformGrid Columns="4" Rows="0" Margin="0,16,0,4">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="NPC ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding NpcId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Map ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding MapId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Name" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Pen name" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding PenName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Talk" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding Talk, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="82"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Model comment" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding ModelComment, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="82"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding CommerceItemsTitle}" FontSize="16" FontWeight="Bold" Margin="0,4,0,8" />
                                <DataGrid ItemsSource="{Binding Items}"
                                          AutoGenerateColumns="False"
                                          Height="190"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#0D151D"
                                          AlternatingRowBackground="#101A24">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Icon" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding IconImage}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Portals / D-Terminal entries" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                        <DataGrid ItemsSource="{Binding Portals}"
                                                  AutoGenerateColumns="False"
                                                  Height="170"
                                                  GridLinesVisibility="Horizontal"
                                                  RowBackground="#0D151D"
                                                  AlternatingRowBackground="#101A24">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Portal Type" Binding="{Binding PortalType, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                                <DataGridTextColumn Header="Portal Count" Binding="{Binding PortalCount, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                                <DataGridTextColumn Header="Resources" Binding="{Binding ResourceCount, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quest links on this NPC" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                        <DataGrid ItemsSource="{Binding QuestLinks}"
                                                  AutoGenerateColumns="False"
                                                  Height="170"
                                                  GridLinesVisibility="Horizontal"
                                                  RowBackground="#0D151D"
                                                  AlternatingRowBackground="#101A24">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Quest ID" Binding="{Binding QuestId, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                                <DataGridTextColumn Header="Quest" Binding="{Binding QuestTitle}" Width="*" />
                                                <DataGridTextColumn Header="Act" Binding="{Binding ActType, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                                <DataGridTextColumn Header="Complete State" Binding="{Binding CompleteState, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Quests">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quests" FontSize="18" FontWeight="Bold" />
                                <Button Grid.Column="1" Content="New" Click="NewQuest_Click" Padding="10,6" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                            </Grid>
                            <TextBox x:Name="QuestSearchBox"
                                     Grid.Row="1"
                                     Margin="0,10,0,8"
                                     TextChanged="QuestFilter_Changed"
                                     ToolTip="Filter by quest id, title, objective, item, or NPC." />
                            <ComboBox x:Name="QuestTypeFilterComboBox"
                                      Grid.Row="2"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="QuestFilter_Changed"
                                      Margin="0,0,0,8" />
                            <TextBox x:Name="QuestTargetFilterBox"
                                     Grid.Row="3"
                                     Margin="0,0,0,10"
                                     TextChanged="QuestFilter_Changed"
                                     ToolTip="Filter by start/completion NPC id or name." />
                            <ListBox x:Name="QuestListBox"
                                     Grid.Row="4"
                                     SelectionChanged="QuestListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding ElementName=QuestListBox, Path=SelectedItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding QuestId, StringFormat=Quest {0}}" FontSize="14" Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding TitleTitle}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding QuestTypeName}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Simple}" Foreground="#C8D4E3" TextWrapping="Wrap" Margin="0,8,20,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Quest NPC visual" FontWeight="SemiBold" />
                                            <TextBlock Text="Start NPC" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding StartTargetSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ModelRecvSummary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                            <TextBlock Text="Completion target" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding TargetSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ModelCompleteSummary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,16,0,0" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="280" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Quest Type" Foreground="{StaticResource Muted}" />
                                            <ComboBox ItemsSource="{Binding QuestTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValue="{Binding QuestType, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Flow" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding StartTargetSummary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TargetSummary}" TextWrapping="Wrap" Foreground="#C8D4E3" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Flags" Foreground="{StaticResource Muted}" />
                                            <WrapPanel>
                                                <CheckBox Content="Active" IsChecked="{Binding Active, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource Text}" Margin="0,0,12,0" />
                                                <CheckBox Content="Immediate" IsChecked="{Binding Immediate, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource Text}" Margin="0,0,12,0" />
                                                <CheckBox Content="Reset" IsChecked="{Binding Reset, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource Text}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="4" Rows="0" Margin="0,16,0,4">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Quest ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding QuestId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Level" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Start Target Type" Foreground="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding QuestStartTargetOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding StartTargetType, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="DisplayName" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Start Target ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding StartTargetId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Complete Target Type" Foreground="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding QuestCompletionTargetOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding TargetType, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="DisplayName" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Complete Target ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Recv Model" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding ModelIdRecv, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Complete Model" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding ModelIdComplete, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Quest title" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Title tab" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding TitleTab, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Items supplied when quest is accepted" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Add Supply" Click="AddQuestSupply_Click" Padding="10,6" />
                                </Grid>
                                <DataGrid x:Name="QuestSupplyGrid"
                                          ItemsSource="{Binding Supplies}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Height="150"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#0D151D"
                                          AlternatingRowBackground="#101A24">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Icon" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding IconImage}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Type" Width="210">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding QuestSupplyTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="DisplayName" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                        <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="260" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,16,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Completion requirements / goals" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Add Requirement" Click="AddQuestGoal_Click" Padding="10,6" />
                                </Grid>
                                <DataGrid x:Name="QuestGoalGrid"
                                          ItemsSource="{Binding Goals}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Height="230"
                                          RowHeight="58"
                                          RowDetailsVisibilityMode="VisibleWhenSelected"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#0D151D"
                                          AlternatingRowBackground="#101A24">
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border Background="#081018"
                                                    BorderBrush="#1D3343"
                                                    BorderThickness="1,0,1,1"
                                                    Padding="10"
                                                    Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Advanced bin fields" Foreground="{StaticResource Muted}" />
                                                        <TextBlock Text="{Binding AdvancedSummary}" Foreground="{StaticResource Text}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="CurType" Foreground="{StaticResource Muted}" />
                                                        <TextBox Text="{Binding CurTypeCount, UpdateSourceTrigger=PropertyChanged}" LostFocus="QuestGoalField_LostFocus" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Sub A" Foreground="{StaticResource Muted}" />
                                                        <TextBox Text="{Binding SubValue, UpdateSourceTrigger=PropertyChanged}" LostFocus="QuestGoalField_LostFocus" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Sub B" Foreground="{StaticResource Muted}" />
                                                        <TextBox Text="{Binding SubValueTwo, UpdateSourceTrigger=PropertyChanged}" LostFocus="QuestGoalField_LostFocus" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Icon" Width="68">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="42"
                                                            Height="42"
                                                            Background="#071018"
                                                            BorderBrush="#244052"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="-"
                                                                       Foreground="{StaticResource Muted}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image Source="{Binding IconImage}"
                                                                   Width="36"
                                                                   Height="36"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Requirement" Width="310">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <ComboBox ItemsSource="{Binding QuestGoalOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedValue="{Binding GoalType, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Id"
                                                                  DisplayMemberPath="DisplayName"
                                                                  DropDownClosed="QuestGoalCombo_DropDownClosed" />
                                                        <TextBlock Text="{Binding FriendlySummary}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Target" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TargetLabel}" Foreground="{StaticResource Muted}" />
                                                            <TextBox Text="{Binding GoalId, UpdateSourceTrigger=PropertyChanged}" LostFocus="QuestGoalField_LostFocus" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="Resolved target" Foreground="{StaticResource Muted}" />
                                                            <TextBlock Text="{Binding TargetTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Amount needed" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="Amount" Foreground="{StaticResource Muted}" />
                                                        <TextBox Text="{Binding GoalAmount, UpdateSourceTrigger=PropertyChanged}" LostFocus="QuestGoalField_LostFocus" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="260" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,16,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rewards given on completion" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Add Reward" Click="AddQuestReward_Click" Padding="10,6" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                                </Grid>
                                <DataGrid x:Name="QuestRewardGrid"
                                          ItemsSource="{Binding Rewards}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Height="210"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#0D151D"
                                          AlternatingRowBackground="#101A24">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Icon" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding IconImage}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Method" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding QuestRewardMethodOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValue="{Binding Method, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="DisplayName" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Type" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding QuestRewardTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValue="{Binding RewardType, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="DisplayName" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Value A" Binding="{Binding ValueALabel}" Width="110" />
                                        <DataGridTextColumn Header="Value A ID/amount" Binding="{Binding ValueA, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                        <DataGridTextColumn Header="Value B" Binding="{Binding ValueBLabel}" Width="100" />
                                        <DataGridTextColumn Header="Value B / Amount" Binding="{Binding ValueB, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                                        <DataGridTextColumn Header="Resolved" Binding="{Binding ResolvedName}" Width="*" />
                                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="260" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Preconditions to unlock/accept" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Add Precondition" Click="AddQuestCondition_Click" Padding="10,6" />
                                        </Grid>
                                        <DataGrid x:Name="QuestConditionGrid"
                                                  ItemsSource="{Binding Conditions}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  Height="170"
                                                  GridLinesVisibility="Horizontal"
                                                  RowBackground="#0D151D"
                                                  AlternatingRowBackground="#101A24">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Type" Width="230">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding QuestPreconditionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedValue="{Binding ConditionType, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Id"
                                                                      DisplayMemberPath="DisplayName" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="ID" Binding="{Binding ConditionId, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                                <DataGridTextColumn Header="Resolved" Binding="{Binding ResolvedName}" Width="*" />
                                                <DataGridTextColumn Header="Count" Binding="{Binding ConditionCount, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="250" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Quest events / completion cues" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Add Event" Click="AddQuestEvent_Click" Padding="10,6" />
                                        </Grid>
                                        <DataGrid x:Name="QuestEventGrid"
                                                  ItemsSource="{Binding Events}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  Height="170"
                                                  GridLinesVisibility="Horizontal"
                                                  RowBackground="#0D151D"
                                                  AlternatingRowBackground="#101A24">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Slot" Binding="{Binding EventSlot, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                                <DataGridTextColumn Header="Event" Binding="{Binding EventName}" Width="150" />
                                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Craft">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Craft" FontSize="18" FontWeight="Bold" />
                                <Button Grid.Column="1" Content="New" Click="NewCraft_Click" Padding="10,6" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                            </Grid>
                            <TextBox x:Name="CraftSearchBox"
                                     Grid.Row="1"
                                     Margin="0,10,0,8"
                                     TextChanged="CraftFilter_Changed"
                                     ToolTip="Filter by craft NPC id, name, map, item id, or item name." />
                            <ComboBox x:Name="CraftMapFilterComboBox"
                                      Grid.Row="2"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="CraftFilter_Changed"
                                      Margin="0,0,0,10" />
                            <ListBox x:Name="CraftListBox"
                                     Grid.Row="3"
                                     SelectionChanged="CraftListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MapDisplay}" Foreground="{StaticResource Accent}" FontSize="11" />
                                            <TextBlock Text="{Binding AssetSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding ElementName=CraftListBox, Path=SelectedItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NpcId, StringFormat=Craft NPC {0}}" FontSize="14" Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding NameTitle}" FontSize="22" FontWeight="Bold" />
                                        <TextBlock Text="{Binding MapDisplay}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding AssetSummary}" Foreground="#C8D4E3" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#0B1117" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="NPC visual" FontWeight="SemiBold" />
                                            <Border Height="86" Margin="0,8,0,8" Background="#071018" BorderBrush="#233446" BorderThickness="1" CornerRadius="6">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ModelId, StringFormat=Model {0}}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModelComment}" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="200" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding VisualSummary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="4" Rows="0" Margin="0,16,0,4">
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="NPC ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding NpcId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Map ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding MapId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Name" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Model ID" Foreground="{StaticResource Muted}" />
                                        <TextBox Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Craft recipes from ItemList.bin / ItemProductionTable" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="1">
                                        <Button Content="New Recipe" Click="AddCraftRecipe_Click" Padding="10,6" Background="#123B33" BorderBrush="{StaticResource Accent}" />
                                        <Button Content="Add Material" Click="AddCraftMaterial_Click" Margin="8,0,0,0" Padding="10,6" />
                                        <Button Content="Refresh Names" Click="RefreshCraftRecipe_Click" Margin="8,0,0,0" Padding="10,6" />
                                    </WrapPanel>
                                </Grid>
                                <DataGrid x:Name="CraftRecipeGrid"
                                          ItemsSource="{Binding CraftRecipes}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Height="260"
                                          SelectionChanged="CraftRecipeGrid_SelectionChanged"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#0D151D"
                                          AlternatingRowBackground="#101A24">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Icon" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding IconImage}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Seq ID" Binding="{Binding SequencialId, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Result Item ID" Binding="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                        <DataGridTextColumn Header="Result Item" Binding="{Binding ItemName}" Width="*" />
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Chance %" Binding="{Binding SuccessRate, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        <DataGridTextColumn Header="Cost" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <DataGridTextColumn Header="Main Cat" Binding="{Binding MainCategoryId, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                                        <DataGridTextColumn Header="Main Name" Binding="{Binding MainCategoryName, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                        <DataGridTextColumn Header="Sub Cat" Binding="{Binding SubCategoryId, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Sub Name" Binding="{Binding SubCategoryName, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                        <DataGridTextColumn Header="Rate Assist" Binding="{Binding PercentageAssistGroup, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        <DataGridTextColumn Header="Protect" Binding="{Binding ProtectAssistGroup, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Materials for selected recipe" FontSize="16" FontWeight="Bold" Margin="0,16,0,8" />
                                <DataGrid x:Name="CraftMaterialGrid"
                                          ItemsSource="{Binding ElementName=CraftRecipeGrid, Path=SelectedItem.Materials}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="True"
                                          Height="180"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#0D151D"
                                          AlternatingRowBackground="#101A24">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Icon" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding IconImage}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Material Item ID" Binding="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                        <DataGridTextColumn Header="Material Item" Binding="{Binding ItemName}" Width="*" />
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Shop">
