LOAD DATABASE
     FROM mysql://dso:dso_password@host.docker.internal:3306/dso
     INTO postgresql://dso:dso_password@postgres:5432/dso

 WITH include drop,
      create tables,
      create indexes,
      reset sequences,
      foreign keys,
      quote identifiers

 SET maintenance_work_mem to '512 MB',
     work_mem to '16 MB'

 CAST type datetime to timestamptz drop default drop not null using zero-dates-to-null,
      type date drop default drop not null using zero-dates-to-null;
